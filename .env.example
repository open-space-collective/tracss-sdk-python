# Required: Okta client credentials for TraCSS API auth
TRACSS_CLIENT_ID=
TRACSS_CLIENT_SECRET=

# Optional: Override Okta endpoints (defaults baked into client.py)
# TRACSS_OKTA_DOMAIN=tracssamu.okta-gov.com
# TRACSS_OKTA_AUTH_SERVER_ID=aus1358llxDldKxE80j7
# TRACSS_OKTA_SCOPE=tracssusername

# Optional: Override Prism mock server URLs for integration tests
# TRACSS_SUBSCRIBER_URL=http://localhost:4010
# TRACSS_BULKDATA_URL=http://localhost:4011
# TRACSS_METADATA_URL=http://localhost:4012
